{
  "name": "zeroknow-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental ZeroKnow protocol repository. Under active development. Not audited.",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "packages/*",
    "backend/indexer"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,sol}\"",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
